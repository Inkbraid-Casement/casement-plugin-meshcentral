{
  "format": "casement-plugin",
  "version": 1,
  "id": "meshcentral",
  "name": "MeshCentral",
  "description": "Remote desktop to MeshCentral agents",
  "icon": "icon.png",
  "program": "casement-meshcentral.exe",
  "homepage": "https://github.com/Inkbraid-Casement/casement-plugin-meshcentral",
  "capabilities": ["password", "clipboard", "cursor"],
  "connections": [
    {
      "scheme": "meshcentral",
      "name": "MeshCentral device",
      "fields": [
        { "name": "user", "label": "User or login token name", "part": "user", "type": "text", "required": true },
        { "name": "server", "label": "Server", "part": "host", "type": "text", "required": true, "placeholder": "mesh.example.com" },
        { "name": "port", "label": "Port", "part": "port", "type": "number", "placeholder": "443" },
        { "name": "device", "label": "Device name or node id", "part": "path", "type": "text", "required": true, "placeholder": "Reception-PC" },
        { "name": "group", "label": "Device group", "part": "query", "type": "text", "placeholder": "Office" },
        { "name": "display", "label": "Display", "part": "query", "type": "number", "placeholder": "all" },
        { "name": "quality", "label": "JPEG quality", "part": "query", "type": "number", "placeholder": "50" },
        { "name": "fps", "label": "Max frames per second", "part": "query", "type": "number", "placeholder": "10" },
        { "name": "thumbprint", "label": "Certificate SHA-256", "part": "query", "type": "text" }
      ]
    }
  ]
}
